# ==========================================
# MWANA GLOBAL - Environment Configuration
# Copy this to .env and fill in your values
# ==========================================

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_USER=mwana_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mwana_global
DATABASE_URL=postgresql://mwana_user:your_secure_password_here@localhost:5432/mwana_global

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_very_long_random_jwt_secret_here_min_64_chars
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Resend recommended - free 3000/month)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@mwanaglobal.com
EMAIL_FROM_NAME=Mwana Global

# Cloudinary (Free tier: 25GB storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key

# Paynow Zimbabwe
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
PAYNOW_RETURN_URL=http://localhost:3000/payment/return
PAYNOW_RESULT_URL=http://localhost:3001/api/payments/webhook

# Next.js Public Variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
